<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My Data — Right to Access" android:textColor="@color/primary" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Review the complete personal, exercise and diet information currently stored by this app." android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/tvMyData" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/card_bg" android:textColor="@color/text_primary" android:textSize="14sp" android:lineSpacingExtra="3dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="12dp" android:background="@color/card_background" android:text="🔒 Privacy: data is protected locally and is not sent to a server. You control access and deletion." android:textColor="@color/text_secondary" android:textSize="12sp" />
        <Button android:id="@+id/btnBackToMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:backgroundTint="@color/primary" android:text="Back to Menu" android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
