<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp" android:padding="14dp" android:background="@drawable/card_bg">
    <TextView android:id="@+id/tvExerciseType" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/primary" android:textStyle="bold" android:textSize="16sp" />
    <TextView android:id="@+id/tvExerciseStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_primary" android:textSize="14sp" />
    <TextView android:id="@+id/tvExerciseDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
</LinearLayout>
