<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Summary Report" android:textColor="@color/primary" android:textSize="22sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:padding="10dp" android:background="@drawable/card_bg" android:text="🔒 Secure local processing • No server transmission" android:textColor="@color/text_secondary" android:textSize="12sp" />
<TextView android:id="@+id/tvProfileInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="14dp" android:background="@color/card_background" android:textColor="@color/text_primary" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Calories Consumed vs Burned" android:textColor="@color/text_primary" android:textStyle="bold" />
<TextView android:id="@+id/tvConsumed" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_primary" />
<ProgressBar android:id="@+id/progressCalories" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="16dp" android:layout_marginTop="4dp" android:max="100" android:progressTint="@color/accent" />
<TextView android:id="@+id/tvBurned" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/text_primary" />
<TextView android:id="@+id/tvBmi" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="14dp" android:background="@color/card_background" android:textColor="@color/text_primary" android:textStyle="bold" />
<TextView android:id="@+id/tvNetBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="14dp" android:background="@color/card_background" android:textColor="@color/primary_dark" android:textStyle="bold" android:textSize="16sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Activity Counts" android:textColor="@color/text_primary" android:textStyle="bold" />
<TextView android:id="@+id/tvCounts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="14dp" android:background="@color/card_background" android:textColor="@color/text_primary" />
<Button android:id="@+id/btnViewMyData" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:backgroundTint="@color/card_background" android:textColor="@color/text_primary" android:text="👁  Review My Stored Data (Right to Access)" />
<Button android:id="@+id/btnBackToMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/primary" android:text="Back to Menu" android:textColor="@color/white" />
<Button android:id="@+id/btnDeleteData" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/danger" android:text="Delete My Data (GDPR Right to Erasure)" android:textColor="@color/white" />
</LinearLayout></ScrollView>
