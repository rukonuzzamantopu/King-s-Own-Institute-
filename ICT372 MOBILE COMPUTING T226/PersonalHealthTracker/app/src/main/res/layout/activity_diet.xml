<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background" android:padding="20dp">
<TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Log Meal / Diet Entry" android:textColor="@color/primary" android:textSize="21sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="10dp" android:background="@drawable/card_bg" android:text="🔒 Stored securely on this device" android:textColor="@color/text_secondary" android:textSize="12sp" />
<EditText android:id="@+id/etMealName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="Meal / Food Name" android:inputType="textCapSentences" android:padding="12dp" android:background="@color/card_background" />
<Spinner android:id="@+id/spinnerMealType" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="12dp" android:background="@color/card_background" />
<EditText android:id="@+id/etCalories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Calories (kcal)" android:inputType="number" android:padding="12dp" android:background="@color/card_background" />
<Button android:id="@+id/btnAddDiet" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:backgroundTint="@color/accent" android:text="Save Meal Entry" android:textColor="@color/white" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Your Diet Log" android:textColor="@color/text_primary" android:textStyle="bold" />
<ListView android:id="@+id/lvDiet" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:divider="@android:color/transparent" android:dividerHeight="6dp" android:clipToPadding="false" android:paddingBottom="4dp" />
<Button android:id="@+id/btnBackToMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:backgroundTint="@color/card_background" android:textColor="@color/text_primary" android:text="Back to Menu" />
</LinearLayout>